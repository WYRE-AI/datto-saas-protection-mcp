# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway Compose service does not load these. Do not add them to that
# service's environment or via env_file. Gateway mode requires
# X-Datto-SaaS-Public-Key and X-Datto-SaaS-Secret-Key on each request.
DATTO_SAAS_PUBLIC_KEY=
DATTO_SAAS_SECRET_KEY=
# Deprecated and ignored: Datto has a single API host (api.datto.com).
# DATTO_SAAS_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# gateway: X-Datto-SaaS-Public-Key and X-Datto-SaaS-Secret-Key on each /mcp
#          request. Never falls back to DATTO_SAAS_*. Docker image and Compose
#          default.
# env:     use DATTO_SAAS_* after X-Gateway-S2S verifies.
AUTH_MODE=gateway

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, your-s2s-secret, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only. A non-loopback MCP_HTTP_HOST is overridden.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when CONDUIT_S2S_SECRET is set. Unset defaults to 127.0.0.1.
# The container image and Compose set 0.0.0.0 inside the container and publish
# the host port on 127.0.0.1. The insecure-dev bypass ignores this and binds
# 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080
